/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run genome_annotator -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 12,
        memory: '20.GB',
        time: '4.h'
    ]

    withName: 'BRAKER3' {
        ext.args   = { [
            "--gm_max_intergenic 10000" // to make the test run faster; see https://github.com/Gaius-Augustus/BRAKER#data-description
        ].join(' ').trim() }
    }
}

params {

    input  = "tests/test_data/samplesheets/test_braker.yaml"
    outdir = "./results/test_braker/"
    skip_masking = true
    skip_functional_annotation = true
    skip_orthodb_download = true
    skip_qc = true
}
