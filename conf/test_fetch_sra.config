/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run genome_annotator -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 12,
        memory: '20.GB',
        time: '4.h'
    ]
}

params {

    input  = "tests/test_data/samplesheets/test_fetch_sra.yaml"
    outdir = "./results/test_fetch_sra/"
    sra_max_size = '1Gb'
    nb_short_read_sra_datasets = 1
    nb_long_read_sra_datasets = 1
    sra_random_seed = 42
    skip_masking = true
    fetch_sra_rnaseq = true
    force_prepare_rnaseq  = true
    skip_structural_annotation = true
    skip_functional_annotation = true
    skip_orthodb_download = true
    skip_qc = true
}
