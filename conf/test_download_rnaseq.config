/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run genome_annotator -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 12,
        memory: '20.GB',
        time: '4.h'
    ]
}

params {

    input  = "tests/test_data/samplesheets/test_download_rnaseq.yaml"
    outdir = "./results/test_download_rnaseq/"
    skip_masking = true
    short_read_mapper = 'star'
    read_sampling_size = 0.01
    skip_structural_annotation = true
    skip_functional_annotation = true
    skip_orthodb_download = true
    skip_qc = true
}
