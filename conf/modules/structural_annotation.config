process {

    withName: 'BRAKER3' {
        ext.args = {[
            "--verbosity=4",
            //"--AUGUSTUS_ab_initio",
            //"--UTR=off",
            //"--addUTR=off"
        ].join(' ').trim()}
    }

    withName: 'SEQKIT_CONCAT' {
        ext.args   = { [
            "--full"
        ].join(' ').trim() }
    }

}
