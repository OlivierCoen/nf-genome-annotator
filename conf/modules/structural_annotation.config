process {

    withName: 'BRAKER3' {
        ext.args = {[
            "--verbosity=4",
            //"--AUGUSTUS_ab_initio",
            //"--UTR=off",
            //"--addUTR=off"
        ].join(' ').trim()}
    }

    withName: 'BRAKER_ISOSEQ' {
        container = { 'docker://teambraker/braker3:isoseq' }
    }


    withName: 'SEQKIT_CONCAT' {
        ext.args   = { [
            "--full"
        ].join(' ').trim() }
    }

}
