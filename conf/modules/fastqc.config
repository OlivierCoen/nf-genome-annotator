process {

    withName: '.*:SHORT_READ_PREPARATION:FASTQC_RAW' {
        ext.prefix = { "short_reads.raw" }
    }

    withName: '.*:SHORT_READ_PREPARATION:FASTQC_CLEANED' {
        ext.prefix = { "short_reads.cleaned" }
    }

    withName: '.*:LONG_READ_PREPARATION:FASTQC_RAW' {
        ext.prefix = { "long_reads.raw" }
    }

    withName: '.*:LONG_READ_PREPARATION:FASTQC_CLEANED' {
        ext.prefix = { "long_reads.cleaned" }
    }

}
